---
import Layout from '@/layouts/Layout.astro';
import { getCodePrefixFromDate } from '@/lib/data_common';
import { DateTime } from 'luxon';
import { GamesPage } from '@/components/GamesViewer/GamesPage';
import { getCodePrefixes } from '@/lib/matchups';

const { isAuthed } = Astro.locals;
if (!isAuthed) {
  throw new Error('Please login to view matchups');
}

const base_url = Astro.url.pathname;

const codePrefixes = await getCodePrefixes();
const pages = codePrefixes.map((c) => ({
  date_code: c.date_code,
  title: DateTime.fromISO(c.date_code as string).toFormat('ccc, M/d'),
  href: `${base_url}?page=${c.date_code}`,
}));

const codePrefix =
  Astro.url.searchParams.get('page') ?? getCodePrefixFromDate(new Date());
---

<Layout title='Matchups'>
  <GamesPage
    codePrefix={codePrefix}
    userId={Astro.locals.user?.record.id}
    pages={pages}
    client:only
  />
</Layout>
