    "system": false,
    "viewQuery": "SELECT\n    (ROW_NUMBER() OVER()) as id,\n    users.id as user,\n    COALESCE(SUM(wsv.total_picks), 0) as total_picks,\n    COALESCE(SUM(wsv.win_picks), 0) as win_picks,\n    COALESCE(SUM(wsv.lose_picks), 0) as lose_picks,\n    ROUND(\n        CAST(SUM(wsv.win_picks) AS FLOAT) / \n        NULLIF(SUM(wsv.total_picks), 0) * 100,\n        2\n    ) as win_pick_rate,\n    ROUND(\n        CAST(SUM(wsv.win_picks) AS FLOAT) / \n        NULLIF(SUM(wsv.lose_picks), 0),\n        2\n    ) as win_loss_ratio\nFROM users\nLEFT JOIN weekly_stats wsv ON wsv.user = users.id\nGROUP BY users.id;"
  },
