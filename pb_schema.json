    "system": false,
    "viewQuery": "SELECT \n    (ROW_NUMBER() OVER()) as id,\n    picks.user,\n    strftime('%Y-W%W', datetime(matchups.time_utc, 'start of day')) as year_week,\n    COUNT(picks.id) as total_picks,\n    COUNT(CASE WHEN picks.result = 'W' THEN 1 END) as win_picks,\n    COUNT(CASE WHEN picks.result = 'L' THEN 1 END) as lose_picks,\n    ROUND(\n        CAST(COUNT(CASE WHEN picks.result = 'W' THEN 1 END) AS FLOAT) / \n        NULLIF(COUNT(picks.id), 0) * 100,\n        2\n    ) as win_pick_rate,\n    ROUND(\n        CAST(COUNT(CASE WHEN picks.result = 'W' THEN 1 END) AS FLOAT) / \n        NULLIF(COUNT(CASE WHEN picks.result = 'L' THEN 1 END), 0),\n        2\n    ) as win_loss_ratio\nFROM picks\nJOIN matchups ON picks.matchup = matchups.id\nWHERE picks.status = 'past'\nGROUP BY picks.user, strftime('%Y-%W', matchups.time_utc)\nORDER BY year_week DESC, win_pick_rate DESC;"
  }
