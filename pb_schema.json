    "viewQuery": "SELECT \n  (ROW_NUMBER() OVER()) as id,\n  date_code,\n  matchup_count\nFROM (\n  SELECT \n    SUBSTRING(code, 1, 8) as date_code,\n    COUNT(*) as matchup_count\n  FROM matchups\n  GROUP BY SUBSTRING(code, 1, 8)\n  ORDER BY date_code\n) subquery;"
