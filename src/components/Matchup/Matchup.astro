---
import PreGame from './PreGame.astro';
import { LiveScore } from './LiveScore';
import PostGame from './PostGame.astro';
import { type MatchupType } from '@/lib/definitions';
import { getScoreboardByCode } from '@/lib/scoreboards';

interface Props {
  matchup: MatchupType;
}

const { matchup } = Astro.props;

let gameStatus = 0;

const scoreboard = await getScoreboardByCode(matchup.code);
if (scoreboard) {
  gameStatus = scoreboard.status;
}
---

<div
  class:list={[
    'p-3 flex flex-row justify-between max-w-md h-36',
    'border rounded-xl shadow-md',
  ]}
>
  {
    gameStatus === 0 && (
      <PreGame
        away_code={matchup.away_code}
        home_code={matchup.home_code}
        time_utc={matchup.time_utc}
      />
    )
  }
  {
    [1, 2].includes(gameStatus) && (
      <LiveScore
        id={scoreboard.id}
        away_code={matchup.away_code}
        away_score={scoreboard.away_score}
        home_code={matchup.home_code}
        home_score={scoreboard.home_score}
        status_text={scoreboard.status_text}
        status={gameStatus}
        client:only
      />
    )
  }
  {
    gameStatus === 3 && (
      <PostGame
        away_code={matchup.away_code}
        away_score={scoreboard?.away_score}
        home_code={matchup.home_code}
        home_score={scoreboard?.home_score}
        status_text={scoreboard?.status_text}
      />
    )
  }
</div>
