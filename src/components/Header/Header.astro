---
import { Astronav, MenuItems, MenuIcon } from 'astro-navbar';
import { Image } from 'astro:assets';
import BrandLogo from '@/assets/brand/logo-hires-uncropped.webp';
import { ThemeToggle } from './ThemeToggle';
import { UserDropdown } from './UserDropdown';
import { FeedbackDialog } from '@/components/Feedback/FeedbackDialog';
import { getUserAvatarUrl } from '@/lib/data_common';
import {
  TrophyIcon,
  ClockIcon,
  CalendarDaysIcon,
} from '@heroicons/react/24/outline';

const { pb, user } = Astro.locals;
const isAuthed = pb.authStore.isValid;
const pathname = Astro.url.pathname;
---

<header class='border-b'>
  <div class='lg:flex justify-between p-2 gap-4 mx-auto'>
    <Astronav closeOnClick>
      <div class='flex w-fulllg:w-auto justify-between items-center'>
        <a class='flex flex-row gap-4 items-center' href='/'>
          <Image
            class='rounded-xl w-[50px] h-[50px]'
            src={BrandLogo}
            alt='W Picks Logo'
            width={256}
            height={256}
            loading='eager'
          />
          <h2 class='font-bold text-2xl lg:text-3xl'>W Picks</h2>
        </a>
        <div class='block lg:hidden'>
          <MenuIcon class='text-foreground' />
        </div>
      </div>
      <MenuItems class='hidden lg:flex'>
        <ul
          class='flex flex-col text-xl p-2 text-right lg:items-center lg:flex-row lg:text-left'
        >
          <li>
            <a
              href='/'
              class:list={[
                'flex items-center gap-2 p-2 rounded-lg',
                pathname === '/'
                  ? 'bg-secondary text-secondary-foreground border'
                  : 'hover:text-gray-500',
              ]}
            >
              <TrophyIcon className='w-6 h-6' />
              <span>Leaderboard</span>
            </a>
          </li>
          <li>
            <a
              href='/matchups/today'
              class:list={[
                'flex items-center gap-2 p-2 rounded-lg',
                pathname === '/matchups/today'
                  ? 'bg-secondary text-secondary-foreground border'
                  : 'hover:text-gray-500',
              ]}
            >
              <ClockIcon className='w-6 h-6' />
              <span>Today</span>
            </a>
          </li>
          <li>
            <a
              href='/matchups'
              class:list={[
                'flex items-center gap-2 p-2 rounded-lg',
                pathname === '/matchups'
                  ? 'bg-secondary text-secondary-foreground border'
                  : 'hover:text-gray-500',
              ]}
            >
              <CalendarDaysIcon className='w-6 h-6' />
              <span>Matchups</span>
            </a>
          </li>

          <li>
            {
              isAuthed ? (
                <UserDropdown user={user} client:load />
              ) : (
                <a
                  href='/login'
                  class:list={[
                    'p-2 rounded-lg',
                    pathname === '/login'
                      ? 'bg-secondary text-secondary-foreground border'
                      : 'hover:text-gray-500',
                  ]}
                >
                  Login
                </a>
              )
            }
          </li>
          <li class='pl-2 flex gap-4 justify-end'>
            {isAuthed && <FeedbackDialog client:load />}
            <ThemeToggle client:load />
          </li>
        </ul>
      </MenuItems>
    </Astronav>
  </div>
</header>
