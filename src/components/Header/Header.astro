---
import { Astronav, MenuItems, MenuIcon } from 'astro-navbar';
import { ThemeToggle } from './ThemeToggle';
import { UserDropdown } from './UserDropdown';
import { FeedbackDialog } from '@/components/Feedback/FeedbackDialog';
import { UserIcon } from 'lucide-react';
import { User } from '@/components/Header/User';
import { getUserAvatarUrl } from '@/lib/data_common';
import { navigationItems } from '@/lib/constants';
const { user, isAuthed } = Astro.locals;
const pathname = Astro.url.pathname;
const avatarUrl =
  isAuthed && getUserAvatarUrl(user.record.id, user.record.avatar);
---

<header class='border-b'>
  <div class='lg:flex justify-between p-2 gap-4 mx-auto'>
    <Astronav closeOnClick>
      <div class='flex w-full lg:w-auto justify-between items-center'>
        <a
          class='flex flex-row gap-4 items-center'
          href='/'
          id='logo-link'
          onclick="event.preventDefault(); if (window.history.length > 1) { window.history.back(); } else { window.location.href = '/'; }"
        >
          <img
            class='rounded-xl w-[50px] h-[50px]'
            src='/assets/icons/maskable-icon-512x512.png'
            alt='W Picks Logo'
            width={256}
            height={256}
            loading='eager'
          />
          <h2 class='font-bold text-2xl lg:text-3xl'>W Picks</h2>
        </a>
        <div class='block lg:hidden'>
          <MenuIcon class='text-foreground' />
        </div>
      </div>
      <MenuItems class='hidden lg:flex'>
        <ul
          class='flex flex-col pt-6 lg:pt-0 text-xl text-right lg:items-center lg:flex-row lg:text-left'
        >
          {
            navigationItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center gap-2 py-1 px-2 rounded-lg',
                    pathname === item.href
                      ? 'bg-secondary text-secondary-foreground border'
                      : 'hover:text-gray-500',
                  ]}
                >
                  <item.icon className='w-6 h-6' />
                  <span
                    class:list={[
                      item.label.includes(' ') && 'whitespace-nowrap',
                    ]}
                  >
                    {item.label}
                  </span>
                </a>
              </li>
            ))
          }
          <li>
            {
              isAuthed ? (
                <div class='flex py-1 px-2 rounded-lg'>
                  <div class='hidden lg:block'>
                    <UserDropdown
                      username={user.record.username}
                      avatarUrl={avatarUrl}
                      client:load
                    />
                  </div>
                  <div class='block lg:hidden'>
                    <a href='/profile' class='flex items-center gap-2'>
                      <User
                        username={user.record.username}
                        avatarUrl={avatarUrl}
                        client:load
                      />
                    </a>
                  </div>
                </div>
              ) : (
                <a
                  href='/login'
                  class:list={[
                    'flex items-center gap-2 py-1 px-2 rounded-lg',
                    pathname === '/login'
                      ? 'bg-secondary text-secondary-foreground border'
                      : 'hover:text-gray-500',
                  ]}
                >
                  <UserIcon className='w-6 h-6' />
                  <span>Login</span>
                </a>
              )
            }
          </li>
          <li class='pl-2 flex gap-4 justify-end'>
            {isAuthed && <FeedbackDialog client:load />}
            <ThemeToggle client:load />
          </li>
        </ul>
      </MenuItems>
    </Astronav>
  </div>
</header>
