---
import Header from '@/components/Header/Header.astro';
import '@fontsource/inter';
import '@/globals.css';
import { ClientRouter } from 'astro:transitions';
import Posthog from '@/components/Posthog.astro';
import { APP_NAME } from '@/lib/constants';
import { SettingsProvider } from '@/components/Settings/SettingsProvider';
interface Props {
  title: string;
}

const { title } = Astro.props;
const theme = Astro.cookies.get('theme')?.value || 'theme-light';
const isDark =
  theme === 'dark' ||
  (theme === 'system' &&
    Astro.request.headers.get('sec-ch-prefers-color-scheme') === 'dark');

const settings = Astro.locals.user?.record.settings;
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content='Astro description' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='viewport' content='width=device-width, user-scalable=no' />
    <link rel='icon' type='image/svg+xml' href='/assets/icons/favicon.ico' />
    <link rel='manifest' href='/site.webmanifest' />
    <meta name='generator' content={Astro.generator} />
    <title>{title ? `${title} | ${APP_NAME}` : APP_NAME}</title>
    <script is:inline>
      if (typeof localStorage !== 'undefined') {
        const theme = localStorage.getItem('theme');
        const isDark =
          theme === 'dark' ||
          (theme === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
      }
    </script>
    <ClientRouter />
    <Posthog />
    <script
      defer
      src='https://umuumi.ipv64.de/script.js'
      data-website-id='c0d26e2f-d316-4d61-9606-9b047134846a'></script>
  </head>
  <body>
    <SettingsProvider settings={settings} client:load />
    <div class='flex flex-col min-h-[100dvh]'>
      <Header />
      <div class='flex grow'>
        <div class='w-full'>
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
