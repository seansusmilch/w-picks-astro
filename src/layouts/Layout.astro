---
import Header from '@/components/Header/Header.astro';
import '@fontsource/poppins';
import '@/globals.css';
import { ClientRouter } from 'astro:transitions';
import Posthog from '@/components/Posthog.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<script is:inline>
  // This script runs immediately to avoid flash of incorrect theme
  const getThemePreference = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light';
  };

  // Apply the theme immediately
  const theme = getThemePreference();
  document.documentElement.className = theme;
</script>

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content='Astro description' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='viewport' content='width=device-width, user-scalable=no' />
    <link rel='icon' type='image/svg+xml' href='/assets/icons/favicon.ico' />
    <link rel='manifest' href='/site.webmanifest' />
    <meta name='generator' content={Astro.generator} />
    <title>{title ? `${title} | W Picks` : 'W Picks'}</title>
    <ClientRouter />
    <Posthog />
    <script
      defer
      src='https://umiumi.duckdns.org/script.js'
      data-website-id='c0d26e2f-d316-4d61-9606-9b047134846a'></script>
  </head>
  <body>
    <script>
      // This script handles theme changes and persistence
      function handleThemeChange() {
        const observer = new MutationObserver(() => {
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });

        observer.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
      }

      function applyStoredTheme() {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.classList[theme === 'dark' ? 'add' : 'remove'](
          'dark'
        );
      }

      // Initialize theme handling when the page loads
      document.addEventListener('astro:page-load', () => {
        applyStoredTheme();
        handleThemeChange();
      });

      // Handle theme during page transitions
      document.addEventListener('astro:after-swap', () => {
        applyStoredTheme();
      });

      // Also initialize on first load
      handleThemeChange();
    </script>
    <div class='flex flex-col min-h-[100dvh]'>
      <Header />
      <div class='flex justify-center flex-grow'>
        <div class='p-2 lg:p-4 max-w-screen-xl w-full pb-10'>
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
