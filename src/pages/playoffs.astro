                <span class='text-sm text-center'>EAST</span>
                <div class='border-t border-2 w-full'></div>
                <span class='text-sm text-center'>WEST</span>
            </div>
            {/* West R1 */}
            <div class='h-[700px] flex flex-col justify-around pr-4'>
                {
                    (bracketData.West[1] || []).map((series) => (
                        <PlayoffSeries client:visible series={series} />
                    ))
                }
            </div>
        </div>

        {/* Round 2 Column */}
