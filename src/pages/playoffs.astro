// Use mock data instead of fetching
const response = await fetch(
    'https://cdn.nba.com/static/json/staticData/brackets/2023/PlayoffBracket.json'
);
const data: PlayoffBracketResponse = await response.json();

interface RoundSeries {
    [round: number]: PlayoffBracketSeries[];
}
interface BracketData {
    East: RoundSeries;
    West: RoundSeries;
    Finals: PlayoffBracketSeries | null; // Only one finals series
}

// Process data into a structure suitable for bracket layout
const bracketData: BracketData = data.bracket.playoffBracketSeries.reduce(
    (acc, series) => {
        const { roundNumber, seriesConference } = series;

        if (seriesConference === 'East' || seriesConference === 'West') {
            if (!acc[seriesConference][roundNumber]) {
                acc[seriesConference][roundNumber] = [];
            }
            // Sort within round by displayOrderNumber for consistent placement
            acc[seriesConference][roundNumber].push(series);
            acc[seriesConference][roundNumber].sort(
                (a, b) => a.displayOrderNumber - b.displayOrderNumber
            );
        } else if (seriesConference === 'NBA Finals') {
            acc.Finals = series;
        }

        return acc;
    },
    { East: {}, West: {}, Finals: null } as BracketData
);

const roundNames = ['First Round', 'Conf. Semifinals', 'Conf. Finals', 'NBA Finals'];
---

<Layout title='NBA Playoffs'>
    <h1 class='text-3xl font-bold text-center pb-4'>Playoffs</h1>

    {/* Single horizontal scroll container */}
    <div class='flex overflow-scroll h-[calc(100vh-9rem)]'>
        {/* Round 1 Column */}
        <div class='h-[1500px] shrink-0 flex flex-col justify-center'>
            <h3 class='text-lg font-medium text-center mb-4 sticky top-0 bg-background py-1 z-10'>
                {roundNames[0]}
            </h3>
            {/* East R1 */}
            <div class='h-[700px] flex flex-col justify-around pr-4'>
                {
                    (bracketData.East[1] || []).map((series) => (
                        <PlayoffSeries client:visible series={series} />
                    ))
                }
            </div>
            {/* Divider */}
