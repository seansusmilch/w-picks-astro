---
import Layout from '@/layouts/Layout.astro';
import { getRandomEmoji } from '@/lib/data_common';
import { Image } from 'astro:assets';

const selectedEmoji = getRandomEmoji();
---

<Layout title='Not Found'>
  <div class='flex flex-col items-center justify-center h-[80vh] gap-4'>
    <h1 class='text-xl lg:text-4xl font-bold text-red-500'>404</h1>
    <h1 class='text-xl lg:text-4xl font-bold'>Page not found</h1>
    <Image
      class='border rounded-md shadow-lg w-96 h-auto'
      src={selectedEmoji}
      alt='Emoji'
      width={384}
      height={384}
    />
  </div>
</Layout>
