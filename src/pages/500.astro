---
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getRandomEmoji } from '@/lib/data_common';

interface Props {
  error: unknown;
}

const { error } = Astro.props;

const message = error instanceof Error ? error.message : 'Unknown error';

const selectedEmoji = getRandomEmoji();
---

<Layout title='Error'>
  <div class='flex flex-col items-center justify-center h-[80vh] gap-4'>
    <h1 class='text-xl lg:text-4xl font-bold text-red-500'>500 ERROR:</h1>
    <h1 class='text-xl lg:text-4xl font-bold'>{message}</h1>
    <Image
      class='border rounded-md w-96 h-auto'
      src={selectedEmoji}
      alt='Emoji'
      width={384}
      height={384}
    />
  </div>
</Layout>
