---
import Layout from '@/layouts/Layout.astro';
import { Image } from 'astro:assets';

const emojis = [
  '/assets/emojis/emoji1.png',
  '/assets/emojis/emoji2.gif',
  '/assets/emojis/emoji3.gif',
  '/assets/emojis/emoji4.png',
  '/assets/emojis/emoji5.gif',
  '/assets/emojis/emoji6.jpg',
];

interface Props {
  error: unknown;
}

const { error } = Astro.props;

const message = error instanceof Error ? error.message : 'Unknown error';
// console.error('500 Page Error:', error);

const selectedEmoji = emojis[Math.floor(Math.random() * emojis.length)];
---

<Layout title='Error'>
  <div class='flex flex-col items-center justify-center h-[80vh] gap-4'>
    <h1 class='text-xl lg:text-4xl font-bold text-red-500'>ERROR:</h1>
    <h1 class='text-xl lg:text-4xl font-bold'>{message}</h1>
    <Image
      class='border rounded-md shadow-lg w-96 h-auto'
      src={selectedEmoji}
      alt='Emoji'
      width={384}
      height={384}
    />
  </div>
</Layout>
