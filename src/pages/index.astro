---
import Layout from '@/layouts/Layout.astro';
import { Button } from '@/components/ui/button';
import {
  Calendar,
  Trophy,
  MessageSquare,
  Users,
  BarChart,
  Download,
  ArrowRight,
  Sparkles,
} from 'lucide-react';
---

<Layout title='W Picks - NBA Prediction App'>
  <!-- Hero Section -->
  <section
    class='relative overflow-hidden py-20 px-4 flex flex-col items-center text-center'
  >
    <div
      class='absolute inset-0 bg-gradient-to-b from-primary/5 to-transparent -z-10'
    >
    </div>
    <div
      class='absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-primary/10 rounded-full blur-3xl -z-10'
    >
    </div>

    <img
      src='/assets/icons/maskable-icon-512x512.png'
      alt='W Picks Logo'
      class='w-28 h-28 rounded-xl mb-6 shadow-lg transition-transform hover:scale-105 duration-300'
      width={112}
      height={112}
    />
    <h1
      class='text-5xl font-bold mb-3 bg-clip-text text-transparent bg-gradient-to-r from-primary to-primary/70'
    >
      W Picks
    </h1>
    <p class='text-xl text-muted-foreground mb-8 max-w-md'>
      Your ultimate companion for NBA predictions and pick 'ems
    </p>

    <div class='flex flex-col sm:flex-row gap-4 w-full max-w-xs'>
      <a href='/login' class='w-full group'>
        <Button
          size='lg'
          className='w-full group-hover:shadow-md transition-all duration-300 flex items-center justify-center gap-2'
          client:load
        >
          Get Started <ArrowRight
            className='w-4 h-4 group-hover:translate-x-1 transition-transform'
          />
        </Button>
      </a>
    </div>

    <div class='mt-16 flex items-center gap-2 text-sm text-muted-foreground'>
      <Sparkles className='w-4 h-4 text-primary' />
      <span>Join the community and start predicting NBA games today</span>
    </div>
  </section>

  <!-- App Features -->
  <section class='py-16 px-4'>
    <div class='max-w-6xl mx-auto'>
      <h2 class='text-3xl font-bold mb-3 text-center'>What You Can Do</h2>
      <p class='text-center text-muted-foreground mb-12 max-w-xl mx-auto'>
        Everything you need to enjoy the NBA season with friends and fellow fans
      </p>

      <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
        <div
          class='rounded-xl border bg-card text-card-foreground shadow-sm p-6 flex flex-col items-center text-center hover:shadow-md transition-all duration-300 hover:border-primary/20'
        >
          <div
            class='h-14 w-14 mb-4 text-primary bg-primary/10 rounded-full flex items-center justify-center'
          >
            <Calendar className='w-7 h-7' />
          </div>
          <h3 class='text-xl font-semibold mb-2'>View NBA Matchups</h3>
          <p class='text-muted-foreground'>
            Stay updated with all NBA games and with data from NBA.com
          </p>
        </div>

        <div
          class='rounded-xl border bg-card text-card-foreground shadow-sm p-6 flex flex-col items-center text-center hover:shadow-md transition-all duration-300 hover:border-primary/20'
        >
          <div
            class='h-14 w-14 mb-4 text-primary bg-primary/10 rounded-full flex items-center justify-center'
          >
            <Trophy className='w-7 h-7' />
          </div>
          <h3 class='text-xl font-semibold mb-2'>Make Your Picks</h3>
          <p class='text-muted-foreground'>
            Predict winners for each game and build your prediction record
          </p>
        </div>

        <div
          class='rounded-xl border bg-card text-card-foreground shadow-sm p-6 flex flex-col items-center text-center hover:shadow-md transition-all duration-300 hover:border-primary/20'
        >
          <div
            class='h-14 w-14 mb-4 text-primary bg-primary/10 rounded-full flex items-center justify-center'
          >
            <MessageSquare className='w-7 h-7' />
          </div>
          <h3 class='text-xl font-semibold mb-2'>Share Your Thoughts</h3>
          <p class='text-muted-foreground'>
            Add comments explaining your picks...or say something funny
          </p>
        </div>

        <div
          class='rounded-xl border bg-card text-card-foreground shadow-sm p-6 flex flex-col items-center text-center hover:shadow-md transition-all duration-300 hover:border-primary/20'
        >
          <div
            class='h-14 w-14 mb-4 text-primary bg-primary/10 rounded-full flex items-center justify-center'
          >
            <Users className='w-7 h-7' />
          </div>
          <h3 class='text-xl font-semibold mb-2'>See Community Picks</h3>
          <p class='text-muted-foreground'>
            View what others are predicting and their reasoning
          </p>
        </div>

        <div
          class='rounded-xl border bg-card text-card-foreground shadow-sm p-6 flex flex-col items-center text-center hover:shadow-md transition-all duration-300 hover:border-primary/20'
        >
          <div
            class='h-14 w-14 mb-4 text-primary bg-primary/10 rounded-full flex items-center justify-center'
          >
            <BarChart className='w-7 h-7' />
          </div>
          <h3 class='text-xl font-semibold mb-2'>Track Your Stats</h3>
          <p class='text-muted-foreground'>
            Monitor your weekly performance and climb the leaderboard
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class='max-w-6xl mx-auto'>
    <hr class='border-t my-8 opacity-30' />
  </div>

  <!-- Install Instructions -->
  <section class='py-16 px-4'>
    <div class='max-w-6xl mx-auto'>
      <h2 class='text-3xl font-bold mb-3 text-center'>Install the App</h2>
      <p class='text-center text-muted-foreground mb-12 max-w-xl mx-auto'>
        Get the best experience by installing W Picks on your device
      </p>

      <div
        class='rounded-xl border bg-card text-card-foreground shadow-md p-8 mb-6 bg-gradient-to-br from-card to-card/50'
      >
        <div class='flex flex-col md:flex-row items-start gap-6'>
          <div
            class='h-16 w-16 text-primary bg-primary/10 rounded-full flex items-center justify-center shrink-0 mx-auto md:mx-0'
          >
            <Download className='w-8 h-8' />
          </div>
          <div class='flex-1'>
            <h3 class='text-2xl font-semibold mb-4'>
              Install W Picks on Your Phone
            </h3>
            <p class='text-muted-foreground mb-6 max-w-xl'>
              Get the full app experience with offline capabilities, faster
              loading times, and a native feel.
            </p>

            <div class='grid grid-cols-1 md:grid-cols-2 gap-8'>
              <div class='bg-card/50 p-6 rounded-lg border'>
                <h4 class='font-medium text-lg mb-3'>On iPhone (Safari):</h4>
                <ol
                  class='list-decimal list-inside space-y-3 text-muted-foreground'
                >
                  <li>
                    Tap the <span class='font-semibold text-foreground'
                      >Share</span
                    > button
                  </li>
                  <li>
                    Scroll down and select <span
                      class='font-semibold text-foreground'
                      >Add to Home Screen</span
                    >
                  </li>
                  <li>
                    Tap <span class='font-semibold text-foreground'>Add</span> in
                    the top-right corner
                  </li>
                </ol>
              </div>

              <div class='bg-card/50 p-6 rounded-lg border'>
                <h4 class='font-medium text-lg mb-3'>On Android (Chrome):</h4>
                <ol
                  class='list-decimal list-inside space-y-3 text-muted-foreground'
                >
                  <li>
                    Tap the <span class='font-semibold text-foreground'>⋮</span>
                    menu button
                  </li>
                  <li>
                    Select <span class='font-semibold text-foreground'
                      >Install app</span
                    > or <span class='font-semibold text-foreground'
                      >Add to Home Screen</span
                    >
                  </li>
                  <li>Follow the on-screen instructions</li>
                </ol>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class='py-16 px-4'>
    <div class='max-w-4xl mx-auto'>
      <div
        class='rounded-xl border bg-primary text-primary-foreground shadow-lg p-10 relative overflow-hidden'
      >
        <div
          class='absolute inset-0 bg-gradient-to-br from-primary to-primary/80 -z-10'
        >
        </div>
        <div
          class='absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full translate-x-1/3 -translate-y-1/2 blur-3xl'
        >
        </div>

        <div class='relative z-10'>
          <h2 class='text-3xl font-bold mb-4'>Ready to Make Your Picks?</h2>
          <p class='mb-8 text-primary-foreground/90 max-w-lg'>
            Join the community and start predicting NBA games today. Track your
            success and compete with friends!
          </p>
          <a href='/login'>
            <Button
              variant='secondary'
              size='lg'
              className='font-medium px-8 hover:shadow-lg transition-all duration-300'
              client:load
            >
              Get Started Now
            </Button>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class='text-center py-10 text-sm text-muted-foreground border-t'>
    <div class='max-w-6xl mx-auto px-4'>
      <p>© {new Date().getFullYear()} W Picks. All rights reserved.</p>
      <p class='mt-2'>Made with ❤️ for NBA fans</p>
      <div class='container mt-4 pt-4 border-t border-border/30'>
        <p class='text-xs text-muted-foreground/70'>
          W Picks is not affiliated with, endorsed by, or sponsored by the
          National Basketball Association (NBA). All NBA team names, logos, and
          brands are property of their respective owners.
        </p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Enhanced animations for more dynamic movement */
  @keyframes float {
    0% {
      transform: translateY(0px) translateX(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-8px) translateX(5px) rotate(2deg);
    }
    50% {
      transform: translateY(-15px) translateX(0px) rotate(0deg);
    }
    75% {
      transform: translateY(-8px) translateX(-5px) rotate(-2deg);
    }
    100% {
      transform: translateY(0px) translateX(0px) rotate(0deg);
    }
  }

  img {
    animation: float 8s ease-in-out infinite;
    transform-origin: center;
  }

  /* Add a subtle shadow animation to enhance the floating effect */
  img {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    transition: box-shadow 0.3s ease-in-out;
  }

  img:hover {
    animation-play-state: paused;
    transform: scale(1.1);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
  }
</style>
