---
import Layout from '@/layouts/Layout.astro';
import { Matchup } from '@/components/GamesViewer/Matchup';
import type { MatchupType } from '@/lib/definitions';

const futureMatchup: MatchupType = {
  code: '20240510/BKNBOS',
  time_utc: '2024-05-10T23:00:00Z',
  away_code: 'BKN',
  home_code: 'BOS',
  away_meta: {
    wins: 21,
    losses: 33,
  },
  home_meta: {
    wins: 41,
    losses: 12,
  },
  scoreboard: '',
};

const liveMatchup: MatchupType = {
  code: '20240203/LALNYK',
  time_utc: '2024-02-03T19:30:00Z',
  away_code: 'LAL',
  home_code: 'NYK',
  away_meta: {
    wins: 24,
    losses: 25,
  },
  home_meta: {
    wins: 32,
    losses: 17,
  },
  scoreboard: '20240203LAL2',
};

const liveScoreboard: ScoreboardType = {
  id: '20240203LAL2',
  code: '20240203LAL2',
  created: '2024-02-03T19:30:00Z',
  updated: '2024-02-03T19:30:00Z',
  status: 2,
  status_text: '3rd Quarter',
  home_score: 78,
  away_score: 82,
};

const completedMatchup: MatchupType = {
  code: '20240202/GSWMEM',
  time_utc: '2024-02-02T00:00:00Z',
  away_code: 'GSW',
  home_code: 'MEM',
  away_meta: {
    wins: 19,
    losses: 24,
  },
  home_meta: {
    wins: 18,
    losses: 27,
  },
  scoreboard: '20240202GSW1',
};

const completedScoreboard: ScoreboardType = {
  id: '20240202GSW1',
  code: '20240202GSW1',
  created: '2024-02-02T00:00:00Z',
  updated: '2024-02-02T00:00:00Z',
  status: 3,
  status_text: 'Final',
  home_score: 98,
  away_score: 121,
};
---

<Layout title='Matchup Component Test'>
  <div class='flex flex-col gap-4'>
    <h1 class='text-2xl font-bold mb-4'>Matchup Component Tests</h1>

    <div class='space-y-8'>
      <section>
        <h2 class='text-xl font-semibold mb-2'>Future Game</h2>
        <Matchup matchup={futureMatchup} client:load />
      </section>

      <section>
        <h2 class='text-xl font-semibold mb-2'>Live Game</h2>
        <Matchup
          matchup={liveMatchup}
          scoreboard={liveScoreboard}
          client:load
        />
      </section>

      <section>
        <h2 class='text-xl font-semibold mb-2'>Completed Game</h2>
        <Matchup
          matchup={completedMatchup}
          scoreboard={completedScoreboard}
          client:load
        />
      </section>
    </div>
  </div>
</Layout>
