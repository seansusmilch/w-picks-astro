---
import { Matchup } from '@/components/GamesViewer/Matchup';
import type { MatchupType, ScoreboardType } from '@/lib/definitions';
import Layout from '@/layouts/Layout.astro';

// Sample data for testing
// Pre-game matchup
const preGameMatchup: MatchupType = {
  id: '123456789012345',
  code: '20240610/PORPOR',
  time_utc: '2024-06-10 20:00:00',
  home_code: 'POR',
  away_code: 'POR',
  scoreboard: '',
};

// Pre-game scoreboard
const preGameScoreboard: ScoreboardType = {
  id: '323456789012345',
  code: '20240610/PORPOR',

  status: 1,
  status_text: 'Pre-Game',
  home_score: 0,
  away_score: 0,
};

// Live game matchup
const liveGameMatchup: MatchupType = {
  id: '223456789012345',
  code: '20240610/PORPOR',
  time_utc: '2024-06-10 18:00:00',
  home_code: 'POR',
  away_code: 'POR',
  scoreboard: '323456789012345',
};

// Live game scoreboard
const liveGameScoreboard: ScoreboardType = {
  id: '323456789012345',
  code: '20240610/PORPOR',

  status: 2,
  status_text: '3rd Qtr 10:30',
  home_score: 178,
  away_score: 172,
};

// Post-game matchup
const postGameMatchup: MatchupType = {
  id: '423456789012345',
  code: '20240609/PORPOR',
  time_utc: '2024-06-09 19:00:00',
  home_code: 'POR',
  away_code: 'POR',
  scoreboard: '523456789012345',
};

// Post-game scoreboard
const postGameScoreboard: ScoreboardType = {
  id: '523456789012345',
  code: '20240609/PORPOR',

  status: 3,
  status_text: 'Final',
  home_score: 105,
  away_score: 112,
