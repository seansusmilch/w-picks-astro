---

<Layout title='Matchup Component Test'>
  <h1 class='text-2xl font-bold mb-6'>Matchup Component Test</h1>

  <h2 class='text-xl font-semibold mb-4'>Pre-Game Matchup</h2>
  <Matchup matchup={preGameMatchup} />
  <Matchup matchup={preGameMatchup} scoreboard={preGameScoreboard} />

  <h2 class='text-xl font-semibold mb-4'>Live Game Matchup</h2>
  <Matchup matchup={liveGameMatchup} scoreboard={liveGameScoreboard} />

  <h2 class='text-xl font-semibold mb-4'>Post-Game Matchup</h2>
  <Matchup matchup={postGameMatchup} scoreboard={postGameScoreboard} />
</Layout>
